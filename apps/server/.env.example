# ExamMate API server configuration. Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://exammate:CHANGE_ME@localhost:5432/exammate
# Comma-separated web origins allowed to call the API with cookies.
APP_ORIGINS=http://localhost:5173,http://localhost:4173
PUBLIC_APP_URL=http://localhost:5173
SESSION_TTL_DAYS=30
# Must be true in production (HTTPS only cookies).
COOKIE_SECURE=false
TRUST_PROXY=false
# 32 random bytes, base64, used to encrypt two-factor (TOTP) secrets at rest. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# Rate-limit counters: memory (one process) or postgres (shared by all API instances; default in production).
RATE_LIMIT_STORE=
# Uploaded files are stored here (outside any web root).
STORAGE_DIR=./storage
# Run the background job worker inside the API process (set false and run `npm run worker` separately to scale).
RUN_WORKER_INLINE=true

# Plan quotas (per user per day unless noted)
FREE_DAILY_AI_REQUESTS=30
PREMIUM_DAILY_AI_REQUESTS=500
FREE_MAX_DOCUMENTS=5
PREMIUM_MAX_DOCUMENTS=200
FREE_MAX_UPLOAD_MB=10
PREMIUM_MAX_UPLOAD_MB=50
FREE_DAILY_EXAMS=3
PREMIUM_DAILY_EXAMS=50
PREMIUM_PRICE_LABEL=€4.99 / month
# Only "test" (no real charges) or "none" are implemented.
BILLING_PROVIDER=test

# Local language model (optional). Never a hosted API.
# none | node-llama-cpp (in-process GGUF) | llama-server (llama.cpp server on a loopback address)
LLM_MODE=none
LLM_MODEL_PATH=
# Expected SHA-256 of the GGUF file; loading is refused on mismatch.
LLM_MODEL_SHA256=
LLM_SERVER_URL=http://127.0.0.1:8080
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_MS=60000
LLM_GPU=auto

OCR_ENABLED=true
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=30000
TRACE_RETENTION_DAYS=30
