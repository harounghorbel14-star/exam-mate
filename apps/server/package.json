{
  "name": "@exammate/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "eval": "tsx src/agent/evaluation/cli.ts",
    "train:classifier": "tsx src/agent/training/cli.ts",
    "model:fixture": "python3 scripts/make_test_gguf.py models/test-fixture.gguf",
    "model:verify": "tsx src/agent/models/verifyCli.ts"
  },
  "dependencies": {
    "@exammate/core": "0.1.0",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.22.1"
  }
}
